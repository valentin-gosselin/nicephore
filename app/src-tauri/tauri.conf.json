{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nicéphore",
  "mainBinaryName": "nicephore",
  "version": "0.1.0",
  "identifier": "io.github.valentin-gosselin.nicephore",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nicéphore",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "visible": false,
        "create": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": { "depends": ["fuse3"], "desktopTemplate": "linux/nicephore.desktop" },
      "rpm": { "depends": ["fuse3"], "desktopTemplate": "linux/nicephore.desktop" }
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "gif",
          "webp",
          "avif",
          "bmp",
          "tif",
          "tiff",
          "heic",
          "heif",
          "dng",
          "arw",
          "cr2",
          "cr3",
          "nef",
          "orf",
          "raf",
          "rw2"
        ],
        "name": "Photo",
        "description": "Photo",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "mov",
          "m4v",
          "webm",
          "mkv",
          "avi",
          "3gp"
        ],
        "name": "Vidéo",
        "description": "Vidéo",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/valentin-gosselin/nicephore/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
